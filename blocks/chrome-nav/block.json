{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "osa/chrome-nav",
  "title": "OSA · Menu",
  "category": "osa",
  "icon": "menu",
  "description": "Renders one of the theme's registered nav menus (managed under Appearance → Menus) so the header/footer can be composed from blocks without migrating menus.",
  "textdomain": "osa-arsenal",
  "supports": {
    "html": false,
    "spacing": { "margin": true }
  },
  "attributes": {
    "location": { "type": "string", "default": "" },
    "menuClass": { "type": "string", "default": "" },
    "footerStyle": { "type": "boolean", "default": false },
    "headerStyle": { "type": "boolean", "default": false },
    "depth": { "type": "number", "default": 0 }
  },
  "render": "file:./render.php"
}
