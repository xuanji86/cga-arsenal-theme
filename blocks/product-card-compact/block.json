{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "osa/product-card-compact",
  "title": "OSA · Product Card (Compact)",
  "category": "osa",
  "icon": "products",
  "description": "Image + LOT + grade + name + caliber/year + price. Used inside catalog-grid loops.",
  "textdomain": "osa-arsenal",
  "usesContext": [ "postId", "postType" ],
  "supports": {
    "html": false,
    "spacing": { "margin": false, "padding": false }
  },
  "attributes": {
    "ar": { "type": "string", "default": "5-4" }
  },
  "render": "file:./render.php"
}
